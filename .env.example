## Example environment variables for Self-Correcting RAG Workflow
## Copy this file to .env and fill in the secret values. Do NOT commit .env with real keys.

# Model names (optional overrides):
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# API keys (required for remote model access):
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Maximum number of revision cycles (integer):
MAX_REVISIONS=5
